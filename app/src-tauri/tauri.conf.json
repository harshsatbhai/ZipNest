{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZipNest",
  "version": "1.0.0",
  "identifier": "app.zipnest.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ZipNest",
        "width": 1000,
        "height": 680,
        "minWidth": 780,
        "minHeight": 540,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Harshwardhan Satbhai",
    "copyright": "© 2026 Harshwardhan Satbhai. MIT License.",
    "category": "Utility",
    "shortDescription": "Zip and unzip files and project folders, 100% offline.",
    "longDescription": "ZipNest compresses and extracts files and entire codebases on your own computer. It respects .gitignore, skips node_modules and other junk, supports AES-256 password protection, and blocks unsafe archives. No account, no telemetry, no internet required.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "zip"
        ],
        "name": "ZIP Archive",
        "description": "ZIP Archive",
        "role": "Viewer",
        "mimeType": "application/zip"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "section": "utils",
        "desktopTemplate": "linux/zipnest.desktop"
      }
    }
  }
}
